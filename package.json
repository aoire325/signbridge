{
  "name": "signbridge-asl",
  "version": "1.1.0",
  "main": "expo-router/entry",
  "dependencies": {
    "@expo/ui": "~58.0.20",
    "base64-js": "^1.5.1",
    "expo": "~58.0.14",
    "expo-asset": "~58.0.16",
    "expo-camera": "~58.0.10",
    "expo-clipboard": "~58.0.3",
    "expo-constants": "~58.0.12",
    "expo-dev-client": "~58.0.14",
    "expo-device": "~58.0.5",
    "expo-file-system": "~58.0.9",
    "expo-font": "~58.0.8",
    "expo-glass-effect": "~58.0.4",
    "expo-image": "~58.0.15",
    "expo-image-manipulator": "~58.0.14",
    "expo-linking": "~58.0.13",
    "expo-router": "~58.0.23",
    "expo-splash-screen": "~58.0.10",
    "expo-status-bar": "~58.0.3",
    "expo-symbols": "~58.0.4",
    "expo-system-ui": "~58.0.6",
    "expo-web-browser": "~58.0.6",
    "jpeg-js": "^0.4.4",
    "react": "19.3.0",
    "react-native": "0.88.0",
    "react-native-fast-tflite": "^3.0.1",
    "react-native-gesture-handler": "~3.3.0",
    "react-native-nitro-modules": "^0.37.1",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-screens": "~4.30.0",
    "react-native-worklets": "0.13.0"
  },
  "devDependencies": {
    "@types/jest": "30.0.0",
    "@types/react": "~19.3.0",
    "eslint": "^9.0.0",
    "eslint-config-expo": "~58.0.4",
    "jest": "~30.5.2",
    "jest-expo": "~58.0.11",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "postinstall": "node scripts/patch-expo-modules-jsi.mjs && node scripts/patch-tflite-large-assets.mjs && npm run models:prepare",
    "models:prepare": "node scripts/prepare-model-assets.cjs",
    "start": "expo start --dev-client --lan --scheme signbridge",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "lint": "expo lint",
    "typecheck": "tsc --noEmit",
    "test": "jest --runInBand",
    "test:ios-runtime": "bash scripts/verify-ios-ml-runtimes.sh"
  },
  "jest": {
    "preset": "jest-expo",
    "testMatch": [
      "<rootDir>/tests/**/*.test.ts"
    ]
  },
  "private": true
}


